# ── AWS ────────────────────────────────────────────────────────────────
aws_region         = "us-east-1"
cluster_name       = "event-ticketing"

# ── Network ────────────────────────────────────────────────────────────
vpc_cidr           = "10.0.0.0/16"
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24", "10.0.13.0/24"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]

# ── Database ───────────────────────────────────────────────────────────
db_instance_class  = "db.t4g.micro"
db_allocated_storage = 20
db_name            = "event_ticketing"
db_username        = "etadmin"

# ── EKS ────────────────────────────────────────────────────────────────
eks_version        = "1.30"

# ── Node Groups ────────────────────────────────────────────────────────
on_demand_instance_types = ["t3.small"]
on_demand_min_size       = 2
on_demand_max_size       = 4
on_demand_desired_size   = 2

spot_instance_types      = ["t3.medium", "t3.large", "t4g.medium", "t4g.large"]
spot_min_size            = 0
spot_max_size            = 10
spot_desired_size        = 2

# ── WAF ────────────────────────────────────────────────────────────────
waf_rate_limit = 2000
waf_action     = "count"  # "count" to log only, "block" to enforce

# ── HTTPS (optional — requires a custom domain + Route53 zone) ─────────
# domain_name = "tickets.yourdomain.com"
